# =============================================================================
# Kiwara Tech — Variáveis de Ambiente Necessárias
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este ficheiro para .env (nunca commite .env — está no .gitignore)
#   2. Preencha os valores assinalados como OBRIGATÓRIO
#   3. Em produção, use Replit Secrets em vez de .env
#
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

# ── Base de Dados (PostgreSQL) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kiwara    # OBRIGATÓRIO
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=                                                       # OBRIGATÓRIO
PGDATABASE=kiwara

# ── Segurança — Cifra de Credenciais ──────────────────────────────────────────
# String aleatória >= 32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=                                               # OBRIGATÓRIO

# ── Admin Portal ──────────────────────────────────────────────────────────────
ADMIN_USERNAME=                                                   # OBRIGATÓRIO
ADMIN_PASSWORD=                                                   # OBRIGATÓRIO (mín. 12 chars)

# ── Webhook EMIS / GPO ────────────────────────────────────────────────────────
# Segredo partilhado para verificação HMAC-SHA256 dos webhooks de pagamento
WEBHOOK_SECRET=                                                   # RECOMENDADO em produção

# ── Firebase (Push Notifications — backend FCM) ───────────────────────────────
# Credenciais da Service Account do projecto Firebase
# Configuradas via painel Admin em /admin → FCM Config (guardadas cifradas na BD)
# Não são variáveis de ambiente — configurar via UI.

# ── Firebase (frontend) ───────────────────────────────────────────────────────
# Obter em: console.firebase.google.com → Projecto → Definições → Geral → SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=                                          # Cloud Messaging → Certificados Web Push

# ── Backup para S3 (opcional) ─────────────────────────────────────────────────
BACKUP_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=kiwara/db
BACKUP_ENCRYPTION_KEY=                                            # OBRIGATÓRIO se BACKUP_ENABLED=true (mín. 32 chars)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=af-south-1
